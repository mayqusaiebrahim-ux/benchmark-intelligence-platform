# Copy this file to .env and fill in real values. Never commit the real .env.
# Required by 10_Dashboard/lib/providers/ClaudeProvider.js
ANTHROPIC_API_KEY=sk-...

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=32000

# ─── Authentication (Clerk) ────────────────────────────────────────────────
# Required for team beta. Get both from the Clerk Dashboard → API Keys.
# The publishable key is safe to expose to the browser; the secret key is
# server-only and is never logged.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# LOCAL DEV ONLY — skip Clerk and run as one fixed identity.
# Ignored when CLERK_SECRET_KEY is set or NODE_ENV=production.
# Format: userId|Display Name|email@example.com
# AUTH_DEV_USER=user_localdev|Local Dev|dev@example.com

# ─── Persistent object storage (Cloudflare R2) ─────────────────────────────
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
