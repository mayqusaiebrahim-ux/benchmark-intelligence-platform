# playwright-core resolves its browsers directory via getFromENV(), which
# falls back from process.env.PLAYWRIGHT_BROWSERS_PATH to
# process.env.npm_config_playwright_browsers_path (see node_modules/
# playwright-core/lib/coreBundle.js) — npm injects config set here as
# npm_config_* into the environment of every process it spawns (both
# `npx ... playwright install chromium` at build time and `node
# 10_Dashboard/server.js` at runtime via `npm start`), before that
# process's own module graph loads. This is what actually guarantees
# the install step and the running server agree on where Chromium
# lives, regardless of whether an inline `VAR=value` shell prefix on
# render.yaml's buildCommand/startCommand is being honored as expected.
playwright_browsers_path=0
