# See the project root's .npmrc for the full explanation. Duplicated here
# because `npx --prefix 11_Benchmark_Engine ...` resolves npm config
# relative to this directory, not the root it was invoked from — confirmed
# empirically: an `npm exec --prefix <dir>` child process does NOT see
# npm_config_* values injected by the root .npmrc, even though it does
# inherit a plain shell-exported env var. This is the file that actually
# controls where `playwright install chromium` puts the browser for this
# package, and where its own chromium.launch() calls (discovery/index.js,
# navigation_runner/index.js, vision/screenshotRunner.js, antibot/probe.js)
# look for it at runtime.
playwright_browsers_path=0
