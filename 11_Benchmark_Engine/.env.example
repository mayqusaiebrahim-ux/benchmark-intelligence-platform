# Copy this file to .env and fill in real values. Never commit the real .env.
# Required by 11_Benchmark_Engine/modules/analysis/visionModelClient.js
OPENAI_API_KEY=sk-...

# Feature Benchmark browser provider — see modules/browserLauncher.js.
# "local" (default): chromium.launch() as before, for local development.
# "browserbase": connects to a remote Browserbase Chromium session instead —
# required in production (e.g. Render) where a local Chromium OOMs.
BROWSER_PROVIDER=local

# Required only when BROWSER_PROVIDER=browserbase.
# BROWSERBASE_API_KEY=bb_...
# Only needed if your Browserbase account requires a project id.
# BROWSERBASE_PROJECT_ID=...

# ─── Autonomous (agent-first) navigation ──────────────────────────────────
# NAVIGATION_MODE controls how goal_driven (transactional) feature benchmarks
# navigate. "agent" (default): a UNIVERSAL hybrid browser agent (Stagehand v3,
# DOM + visual/coordinate tools) drives its own session on ANY website and
# decides every action; our code enforces safety, budget, synthetic data, a
# universal stuck-detector, and independent target verification. "heuristic":
# the legacy deterministic GoalNavigator. Agent mode falls back to heuristic
# automatically when the credentials below are missing.
# NAVIGATION_MODE=agent
#
# Agent mode needs BROWSER_PROVIDER=browserbase + BROWSERBASE_API_KEY
# (+ BROWSERBASE_PROJECT_ID if your account needs it) AND an LLM provider key
# for the agent brain — one of OPENAI_API_KEY / ANTHROPIC_API_KEY /
# GEMINI_API_KEY. Stagehand runs disableAPI:true + experimental:true (needed
# to pass our AbortSignal budget), so it calls the model provider directly and
# a concrete model + key is required — "auto" is not valid in this mode.
# Default model: anthropic/claude-sonnet-4-6 with ANTHROPIC_API_KEY — it is
# HYBRID-capable in Stagehand v3.7.3 (DOM + visual/coordinate interaction).
# With only OPENAI_API_KEY the agent runs DOM-only (openai/gpt-4.1-mini).
# Optional overrides:
# AGENT_NAV_MODEL=anthropic/claude-sonnet-4-6   # any hybrid-capable id: contains claude / gemini-3 / gpt-5.4+
# BROWSERBASE_SESSION_TIMEOUT_SECS=900
